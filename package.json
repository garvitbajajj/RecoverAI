{
  "name": "recoverai",
  "version": "0.1.0",
  "description": "Payment failure triage and recovery agent — Razorpay AI Buildathon 2026, Track 03",
  "main": "src/index.js",
  "scripts": {
    "seed": "node src/data/seed.js",
    "start": "node src/index.js",
    "run:batch": "node src/index.js",
    "demo:cap": "node src/index.js --cap-value 5000000 --no-llm",
    "demo:rules": "node src/index.js --no-llm",
    "exceptions": "node src/index.js --exceptions",
    "dashboard": "node src/dashboard/build.js",
    "report": "node src/index.js && node src/dashboard/build.js",
    "dev": "node --watch src/index.js",
    "verify:truth": "node scripts/verify-truth-containment.js",
    "test": "node --test"
  },
  "keywords": [
    "payments",
    "recovery",
    "agent",
    "razorpay"
  ],
  "license": "MIT",
  "dependencies": {}
}
