# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# The agent runs fine with NO key at all: unmapped decline codes stay UNKNOWN
# and escalate to a human, which is a correct outcome. The LLM only adds
# recoveries on top — it can never break a run.

# Free tier, no credit card: https://aistudio.google.com  -> Get API key
GEMINI_API_KEY=

# Optional. Any Gemini model id; the free-tier Flash models are plenty for a
# job this narrow (5 records per batch).
RECOVERAI_MODEL=gemini-3.1-flash-lite
