# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Day 5: LLM diagnosis fallback for unmapped decline codes.
ANTHROPIC_API_KEY=

# Day 5: model used for the diagnosis fallback.
RECOVERAI_MODEL=claude-sonnet-5

# Optional. Razorpay test-mode credentials for live retry calls.
# Leave blank to keep using the offline simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
